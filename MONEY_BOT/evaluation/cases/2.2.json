{
  "suite": "2.2",
  "title": "Nhập ngân sách tổng, sửa hạn mức, phát hiện tổng hạn mức vượt ngân sách",
  "threshold": {"min_cases": 5, "pass_rate": 1.0},
  "today": "2026-11-12",
  "cases": [
    {"id": "2.2-01", "desc": "Tổng hạn mức dưới ngân sách: lưu đúng giá trị",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 1500000, "transport": 1000000}, "threshold": 80}},
       {"req": "GET /budgets/2026-11", "expect": {"total": 3000000, "limits": {"food": 1500000, "transport": 1000000}, "threshold": 80}}]},
    {"id": "2.2-02", "desc": "Tổng hạn mức bằng ngân sách: được lưu",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 2000000, "transport": 1000000}}},
       {"req": "GET /budgets/2026-11", "expect": {"total": 3000000, "limits": {"food": 2000000, "transport": 1000000}}}]},
    {"id": "2.2-03", "desc": "Tổng hạn mức vượt ngân sách: từ chối, không lưu",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 2000000, "transport": 1000001}}, "status": 400,
        "expect": {"message": "Tổng hạn mức danh mục vượt ngân sách tổng."}},
       {"req": "GET /budgets/2026-11", "expect": {"total": null, "limits": {}}}]},
    {"id": "2.2-04", "desc": "Sửa hạn mức sau khi đã lưu làm vượt ngân sách: từ chối, giữ giá trị cũ",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 1500000}}},
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 1500000, "shopping": 1600000}}, "status": 400},
       {"req": "GET /budgets/2026-11", "expect": {"total": 3000000, "limits": {"food": 1500000}}}]},
    {"id": "2.2-05", "desc": "Giảm ngân sách tổng xuống dưới tổng hạn mức đã có: từ chối",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": 2500000}}},
       {"req": "PUT /budgets/2026-11", "body": {"total": 2000000, "limits": {"food": 2500000}}, "status": 400},
       {"req": "GET /budgets/2026-11", "expect": {"total": 3000000}}]},
    {"id": "2.2-06", "desc": "Hạn mức âm: từ chối",
     "steps": [{"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": -1}}, "status": 400}]},
    {"id": "2.2-07", "desc": "Ngân sách tổng bằng 0 hoặc âm: từ chối",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 0, "limits": {}}, "status": 400},
       {"req": "PUT /budgets/2026-11", "body": {"total": -5, "limits": {}}, "status": 400}]},
    {"id": "2.2-08", "desc": "Giá trị không phải số nguyên hoặc danh mục lạ: từ chối",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"food": "1000"}}, "status": 422},
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000.5, "limits": {}}, "status": 422},
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"bills": 1000}}, "status": 400}]},
    {"id": "2.2-09", "desc": "Để trống khác đặt 0: chỉ danh mục có giá trị mới có hạn mức",
     "steps": [
       {"req": "PUT /budgets/2026-11", "body": {"total": 3000000, "limits": {"entertainment": 0}}},
       {"req": "GET /summary?month=2026-11", "expect": {"categories": {"$contains": [
         {"category_id": "entertainment", "limit": 0, "level": "NORMAL"},
         {"category_id": "food", "limit": null, "level": "UNSET"}]}}}]},
    {"id": "2.2-10", "desc": "Tháng không hợp lệ: từ chối",
     "steps": [{"req": "PUT /budgets/2026-13", "body": {"total": 3000000, "limits": {}}, "status": 400}]}
  ]
}
