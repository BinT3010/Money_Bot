       {"req": "GET /budgets/2026-11", "expect": {"threshold": 80}},
       {"req": "PUT /budgets/2026-11", "body": {"total": 5000000, "limits": {"food": 1000000}, "threshold": 1}},
       {"req": "POST /transactions", "body": {"amount_vnd": 10000, "description": "Nước", "category_id": "food", "date": "2026-11-05"}},
       {"req": "GET /summary?month=2026-11", "expect": {"categories": {"$contains": [{"category_id": "food", "level": "WARNING"}]}}}]}
  ]
